# Python
__pycache__/
*.py[cod]
venv/
.venv/
.env
.env.*
!.env.example

# Vector store index (rebuilt on startup)
faiss_index/
backend/faiss_index/
# ONNX export of the reranker (rebuilt on first use / in the Docker build)
backend/onnx_reranker/

# Per-call LLM usage log (backend/llm_provider.py) — runtime data, grows
# forever, never something to commit.
backend/logs/

# Pipeline caches (Lee County API responses, pytest)
.cache/
.pytest_cache/
.test_tmp/
.tmp/

# Runtime user reports (admin inbox)
backend/data/ops/reports.json
backend/data/ops/reports.json.tmp

# Data files (add your own)
data/*.csv
!data/data.csv

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Local eval / feedback artifacts (regeneratable or user-generated)
backend/data/feedback/
backend/data/eval_reports/

# React build output / deps
frontend-react/node_modules/
frontend-react/dist/
frontend-react/.env.local
