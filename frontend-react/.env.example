# Base URL of the FastAPI backend.
# - Local `npm run dev`: defaults to http://localhost:8000 if unset.
# - Production / Cloud Run (SPA served by the API): set empty → VITE_API_BASE=
# - GitHub Pages: https://rag-arcgis-chatbot-ygecps65ja-uc.a.run.app
# - docker-compose web service: http://localhost:8080
VITE_API_BASE=http://localhost:8000

# Asset base path for Vite (GitHub Pages project site uses /rag-arcgis-chatbot/).
# Leave unset for local/Cloud Run ("/").
# VITE_BASE=/rag-arcgis-chatbot/
