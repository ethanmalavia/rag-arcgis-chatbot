# Base URL of the FastAPI backend.
# - Local `npm run dev`: defaults to http://localhost:8000 if unset.
# - Production VPS (SPA served by the API): set empty → VITE_API_BASE=
# - docker-compose web service: http://localhost:8080
VITE_API_BASE=http://localhost:8000

# Asset base path for Vite. Leave unset for "/" (local and production).
