# Copy this file to .env in the backend directory and fill in your values
# Required — sole LLM provider (fact extraction + citizen summary, one call):
# https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: ArcGIS API key if you wire in a custom map layer
ARCGIS_API_KEY=your_arcgis_api_key_here

# Administrator page (/admin) and CSV /load — required for admin mutations.
# Also set as a GitHub Actions secret so Cloud Run deploy injects it.
ADMIN_API_KEY=change-me-to-a-long-random-secret

# Agent-sync MCP over Streamable HTTP (Cloud Run mounts at /mcp).
# Defaults to ADMIN_API_KEY when unset. Local Cursor stdio does not need this.
# ENABLE_MCP_HTTP=true
# MCP_API_KEY=change-me-mcp-token
# AGENT_SYNC_SEED_DIR=/app/agent-sync
# AGENT_SYNC_DIR=/tmp/agent-sync
# For Cursor remote MCP: export ENGAGE_MCP_URL=https://YOUR.run.app/mcp
#                        export ENGAGE_MCP_TOKEN=$MCP_API_KEY

# Pipeline tuning (defaults shown)
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# PROMPT_VARIANT=concise
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# SCORE_THRESHOLD=0.25
# SERVE_FRONTEND=true
# OTEL_ENABLED=false

# Public chat/report rate limits (in-memory per Cloud Run instance)
# ENABLE_RATE_LIMIT=true
# RATE_LIMIT_CHAT_DEVICE=20
# RATE_LIMIT_CHAT_IP=40
# RATE_LIMIT_CHAT_WINDOW_S=60
# RATE_LIMIT_WRITE_DEVICE=10
# RATE_LIMIT_WRITE_IP=20
# RATE_LIMIT_WRITE_WINDOW_S=60
